{
  "name": "Airgap image converter",
  "short_name": "Airgap",
  "description": "Image format converter that runs entirely in your browser and tells you exactly what a conversion throws away. Image bytes are never transmitted anywhere.",
  "id": "/airgap/",
  "start_url": "/airgap/",
  "scope": "/airgap/",
  "display": "standalone",
  "background_color": "#f3f5f8",
  "theme_color": "#1f2a37",
  "icons": [
    { "src": "/airgap/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/airgap/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/airgap/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/airgap/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    {
      "action": "/airgap/",
      "accept": {
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/webp": [".webp"],
        "image/avif": [".avif"],
        "image/jxl": [".jxl"],
        "image/tiff": [".tif", ".tiff"]
      }
    }
  ]
}
