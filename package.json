{
  "name": "airgap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Client-side image format converter. Image bytes are never transmitted anywhere.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:e2e": "playwright test",
    "fixtures": "node scripts/make-fixtures.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/pako": "^2.0.4",
    "@types/pngjs": "^6.0.5",
    "@vitest/browser-playwright": "^5.0.1",
    "exifr": "^7.1.3",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "tiff": "^7.1.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/jxl": "^1.3.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/webp": "^1.5.0",
    "pako": "^2.2.0",
    "utif": "^3.1.0"
  }
}
