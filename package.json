{
  "name": "airgap",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Client-side image format converter. Image bytes are never transmitted anywhere.",
  "scripts": {
    "dev": "vite",
    "check:notices": "node scripts/check-notices.mjs",
    "build": "npm run check:notices && npm run typecheck && vite build && node scripts/write-checksums.mjs",
    "check:budget": "node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:e2e": "playwright test",
    "fixtures": "node scripts/make-fixtures.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jxl": "^1.3.0",
    "@jsquash/qoi": "^1.1.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@types/pako": "^3.0.0",
    "@types/pngjs": "^6.0.5",
    "@vitest/browser-playwright": "^5.0.3",
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "jpeg-js": "^0.4.4",
    "lcms-wasm": "^1.0.5",
    "pngjs": "^7.0.0",
    "tiff": "^7.1.3",
    "typescript": "^7.0.2",
    "upng-js": "^2.1.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.1",
    "wasm-webp": "^0.1.0"
  },
  "dependencies": {
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/webp": "^1.5.0",
    "jxl-oxide-wasm": "^0.12.6",
    "pako": "^3.0.2",
    "utif": "^3.1.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SatvikPraveen/airgap.git"
  },
  "homepage": "https://satvikpraveen.github.io/airgap/"
}
